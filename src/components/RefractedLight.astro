---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['refracted-light-wrapper', className]} aria-hidden="true">
  <canvas id="refracted-light-canvas" class="refracted-canvas"></canvas>
  <div class="vintage-grain-overlay"></div>
  <div class="refracted-fallback"></div>
</div>

<style>
  .refracted-light-wrapper {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    background: #02050b;
  }

  .refracted-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 1;
  }

  /* Analog Film Grain Texture Overlay */
  .vintage-grain-overlay {
    position: absolute;
    inset: -50%;
    width: 200%;
    height: 200%;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.045'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 2;
    opacity: 0.6;
    animation: grainJitter 8s steps(10) infinite;
  }

  @keyframes grainJitter {
    0%, 100% { transform: translate(0, 0); }
    10% { transform: translate(-2%, -3%); }
    20% { transform: translate(3%, 1%); }
    30% { transform: translate(-1%, 2%); }
    40% { transform: translate(2%, -1%); }
    50% { transform: translate(-3%, 3%); }
    60% { transform: translate(1%, -2%); }
    70% { transform: translate(-2%, 1%); }
    80% { transform: translate(3%, -3%); }
    90% { transform: translate(-1%, -1%); }
  }

  .refracted-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(120% 90% at 30% 20%, #0d2238, #02050b 75%);
    z-index: 0;
  }
</style>

<script>
  function initRefractedLight() {
    const canvas = document.getElementById('refracted-light-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const gl =
      (canvas.getContext('webgl', {
        antialias: false,
        alpha: false,
        powerPreference: 'high-performance',
      }) as WebGLRenderingContext | null) ||
      (canvas.getContext('experimental-webgl') as WebGLRenderingContext | null);

    if (!gl) return;

    const vsSource = `
      attribute vec2 p;
      void main() {
        gl_Position = vec4(p, 0.0, 1.0);
      }
    `;

    // Vintage Prism & Water Refraction Shader
    const fsSource = `
      #ifdef GL_FRAGMENT_PRECISION_HIGH
      precision highp float;
      #else
      precision mediump float;
      #endif

      uniform vec2 r;
      uniform float t;
      uniform vec2 m;
      const float TAU = 6.28318530718;

      // Vintage Caustics (patrón periódico con refracción fluida)
      float caustic(vec2 uv, float tm) {
        vec2 p = mod(uv * TAU, TAU) - 250.0;
        vec2 i = p;
        float c = 1.0;
        float inten = 0.0055;
        for (int n = 0; n < 5; n++) {
          float fn = float(n) + 1.0;
          float tt = tm * (1.0 - (3.5 / fn));
          i = p + vec2(cos(tt - i.x) + sin(tt + i.y), sin(tt - i.y) + cos(tt + i.x));
          float divX = sin(i.x + tt) / inten;
          float divY = cos(i.y + tt) / inten;
          if (abs(divX) < 0.0001) divX = 0.0001;
          if (abs(divY) < 0.0001) divY = 0.0001;
          c += 1.0 / length(vec2(p.x / divX, p.y / divY));
        }
        c /= 5.0;
        c = 1.17 - pow(abs(c), 1.4);
        return pow(abs(c), 7.5);
      }

      // Rayo difuso con perfil gaussiano
      float beam(float x, float w) {
        return exp(-x * x / max(w, 0.00001));
      }

      // Ruido pseudo-aleatorio para micrograno analógico
      float filmNoise(vec2 co, float time) {
        return fract(sin(dot(co + vec2(time * 12.34, time * 56.78), vec2(12.9898, 78.233))) * 43758.5453);
      }

      void main() {
        vec2 uv = gl_FragCoord.xy / max(r.y, 1.0);
        vec2 mo = (m - 0.5);
        float T = t * 0.32 + 23.0;

        // Fondo: tono vintage profundo (azul medianoche con tinte cálido ámbar/índigo)
        vec2 n = gl_FragCoord.xy / max(r, vec2(1.0));
        vec3 colDeep = vec3(0.008, 0.014, 0.026);
        vec3 colVintageMid = vec3(0.024, 0.065, 0.115);
        vec3 col = mix(colDeep, colVintageMid, smoothstep(0.0, 1.0, n.y * 0.65 + n.x * 0.35 + mo.y * 0.1));

        // Cáusticas con dispersión cromática y halación cálida estilo película analógica
        vec2 d = vec2(0.011, 0.007) * (1.0 + mo.x * 1.6);
        vec2 q = uv * 0.82 + mo * 0.14;
        vec3 c = vec3(caustic(q, T), caustic(q + d, T), caustic(q + d * 2.0, T));
        
        // Halación vintage: añade sutil calidez rojiza/ámbar en los bordes de dispersión
        vec3 causticColor = vec3(1.15, 1.02, 1.25) * 0.88;
        causticColor += vec3(0.22, 0.08, 0.0) * c.r; // Vintage red halation
        col += c * causticColor;

        // Rayos de luz refractada en prisma vintage
        float a = -0.60 + mo.x * 0.38 + mo.y * 0.18;
        mat2 R = mat2(cos(a), -sin(a), sin(a), cos(a));
        vec2 b = R * (uv - vec2(0.88, 0.5));
        vec3 beams = vec3(0.0);
        for (int k = 0; k < 6; k++) {
          float fk = float(k);
          float pos = -0.9 + fk * 0.34 + sin(t * 0.11 + fk * 2.1) * 0.12;
          float w = 0.0007 + 0.0018 * fract(fk * 0.37 + 0.2);
          float disp = 0.024 + 0.014 * sin(t * 0.18 + fk);
          float fade = smoothstep(-0.9, 0.1, b.y) * (1.0 - smoothstep(0.2, 1.15, b.y));
          vec3 s = vec3(beam(b.x - pos, w), beam(b.x - pos - disp, w), beam(b.x - pos - disp * 2.0, w));
          
          // Paleta vintage cálido/frío: ámbar dorado 35mm -> cian espectral
          vec3 warmAmber = vec3(1.05, 0.82, 0.52);
          vec3 coolPrism = vec3(0.48, 0.78, 0.98);
          s *= mix(warmAmber, coolPrism, 0.5 + 0.5 * sin(b.y * 3.2 + fk));
          beams += s * fade * (0.55 + 0.45 * sin(t * 0.45 + fk * 1.7));
        }
        col += beams * 0.58;

        // Halo óptico vintage suave alrededor del cursor y la fuente de luz
        float hLight = exp(-length(uv - vec2(1.55, 0.88) - mo * 0.22) * 1.5);
        col += vec3(0.32, 0.48, 0.72) * hLight * 0.38;

        // Resplandor cálido sutil que sigue al cursor del mouse (vintage optical flare)
        vec2 mouseUV = vec2(m.x * (r.x / r.y), 1.0 - m.y);
        float mouseGlow = exp(-length(uv - mouseUV) * 2.6);
        col += vec3(0.28, 0.36, 0.55) * mouseGlow * 0.25;

        // Viñeta vintage analógica (bordes oscurecidos con curvatura de lente)
        float distFromCenter = length(n - 0.5);
        col *= 1.0 - 0.58 * pow(distFromCenter * 1.35, 1.8);

        // Micro-grano fílmico embebido en el sombreador
        float grain = (filmNoise(gl_FragCoord.xy, t) - 0.5) * 0.035;
        col += vec3(grain);

        // Tone mapping cinematográfico (curva de película retro)
        col = 1.0 - exp(-col * 1.48);
        col = pow(max(col, vec3(0.0)), vec3(0.94));

        gl_FragColor = vec4(col, 1.0);
      }
    `;

    function compileShader(type: number, source: string): WebGLShader | null {
      if (!gl) return null;
      const shader = gl.createShader(type);
      if (!shader) return null;
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
        console.warn('Shader compile error:', gl.getShaderInfoLog(shader));
        gl.deleteShader(shader);
        return null;
      }
      return shader;
    }

    const vs = compileShader(gl.VERTEX_SHADER, vsSource);
    const fs = compileShader(gl.FRAGMENT_SHADER, fsSource);
    if (!vs || !fs) return;

    const program = gl.createProgram();
    if (!program) return;
    gl.attachShader(program, vs);
    gl.attachShader(program, fs);
    gl.linkProgram(program);

    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      console.warn('Program link error:', gl.getProgramInfoLog(program));
      gl.deleteProgram(program);
      return;
    }

    gl.useProgram(program);

    const buffer = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 3, -1, -1, 3]),
      gl.STATIC_DRAW
    );

    const positionLocation = gl.getAttribLocation(program, 'p');
    gl.enableVertexAttribArray(positionLocation);
    gl.vertexAttribPointer(positionLocation, 2, gl.FLOAT, false, 0, 0);

    const uR = gl.getUniformLocation(program, 'r');
    const uT = gl.getUniformLocation(program, 't');
    const uM = gl.getUniformLocation(program, 'm');

    let animationId: number;
    let isDisposed = false;

    function resize() {
      if (!canvas || !gl || isDisposed) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      const displayWidth = Math.max(1, Math.floor(canvas.clientWidth * dpr));
      const displayHeight = Math.max(1, Math.floor(canvas.clientHeight * dpr));

      if (canvas.width !== displayWidth || canvas.height !== displayHeight) {
        canvas.width = displayWidth;
        canvas.height = displayHeight;
      }
      gl.viewport(0, 0, canvas.width, canvas.height);
    }

    window.addEventListener('resize', resize, { passive: true });
    resize();

    let tx = 0.5;
    let ty = 0.5;
    let mx = 0.5;
    let my = 0.5;

    function setCoordinates(clientX: number, clientY: number) {
      tx = clientX / Math.max(window.innerWidth, 1);
      ty = 1 - clientY / Math.max(window.innerHeight, 1);
    }

    function onPointerMove(e: PointerEvent) {
      setCoordinates(e.clientX, e.clientY);
    }

    function onTouchMove(e: TouchEvent) {
      if (e.touches && e.touches.length > 0) {
        const touch = e.touches[0];
        setCoordinates(touch.clientX, touch.clientY);
      }
    }

    window.addEventListener('pointermove', onPointerMove, { passive: true });
    window.addEventListener('touchmove', onTouchMove, { passive: true });

    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const t0 = performance.now();

    function render(now: number) {
      if (isDisposed || !gl || !canvas) return;

      // Smooth inertia mouse tracking
      mx += (tx - mx) * 0.045;
      my += (ty - my) * 0.045;

      gl.uniform2f(uR, canvas.width, canvas.height);
      gl.uniform1f(uT, ((now - t0) / 1000) * (calm ? 0.2 : 1.0));
      gl.uniform2f(uM, mx, my);

      gl.drawArrays(gl.TRIANGLES, 0, 3);
      animationId = requestAnimationFrame(render);
    }

    animationId = requestAnimationFrame(render);

    document.addEventListener(
      'astro:before-swap',
      () => {
        isDisposed = true;
        cancelAnimationFrame(animationId);
        window.removeEventListener('resize', resize);
        window.removeEventListener('pointermove', onPointerMove);
        window.removeEventListener('touchmove', onTouchMove);

        if (gl) {
          gl.deleteBuffer(buffer);
          gl.deleteShader(vs);
          gl.deleteShader(fs);
          gl.deleteProgram(program);
        }
      },
      { once: true }
    );
  }

  initRefractedLight();
  document.addEventListener('astro:page-load', initRefractedLight);
</script>
