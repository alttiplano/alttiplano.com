---
import Logo from '@/components/ui/header/logo.astro';
---

<header>
  <div class="veil" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <nav aria-label="Primary navigation">
    <Logo />
  </nav>
</header>

<style>
  header {
    --overhang: 2rem; /* how far the effect extends below the header */

    position: sticky;
    top: 0;
    z-index: 50;
  }

  .veil,
  header::after {
    position: absolute;
    inset: 0 0 calc(var(--overhang) * -1);
    z-index: -1;
    pointer-events: none;
  }

  /* Progressive blur: each layer is stronger and shorter than the previous one */
  .veil i {
    --mask: linear-gradient(to bottom, #000 var(--hold), transparent var(--end));

    position: absolute;
    inset: 0;
    -webkit-backdrop-filter: blur(var(--blur));
    backdrop-filter: blur(var(--blur));
    -webkit-mask-image: var(--mask);
    mask-image: var(--mask);
  }

  .veil i:nth-child(1) {--blur: 1px;--hold: 55%;--end: 100%;}
  .veil i:nth-child(2) {--blur: 3px;--hold: 40%;--end: 85%;}
  .veil i:nth-child(3) {--blur: 6px;--hold: 30%;--end: 70%;}
  .veil i:nth-child(4) {--blur: 12px;--hold: 20%;--end: 55%;}

  /* Tint: unmasked color gradient on top of the blur, keeps the logo readable */
  header::after {
    content: '';
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-bg) 80%, transparent) 0%,
      color-mix(in srgb, var(--color-bg) 62%, transparent) 30%,
      color-mix(in srgb, var(--color-bg) 30%, transparent) 60%,
      color-mix(in srgb, var(--color-bg) 8%, transparent) 85%,
      transparent 100%
    );
  }

  nav {
    display: flex;
    justify-content: center;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(1.125rem, 3vw, 1.25rem) clamp(1rem, 4vw, 1.5rem);
  }
</style>
