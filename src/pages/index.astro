---
import Layout from '@/layouts/Layout.astro';
import RefractedLight from '@/components/RefractedLight.astro';
import { SITE } from '@/consts';
import logoImg from '@/assets/images/alttiplano-transparent.png';
import { Image } from 'astro:assets';
---

<Layout title="Home" hideNavAndFooter={true}>
  <div class="minimal-scene" id="scene-root">
    <!-- Vintage Refracted Light WebGL Background -->
    <RefractedLight />

    <!-- Centered Minimalist Content with Subtle Mouse Parallax -->
    <main class="minimal-content" id="hero-card">
      <!-- Alttiplano Brand Logo -->
      <div class="logo-wrapper">
        <div class="logo-backdrop"></div>
        <Image
          src={logoImg}
          alt="Alttiplano Logo"
          width={58}
          height={58}
          class="brand-logo"
          loading="eager"
        />
      </div>

      <!-- Pill Badge from Screenshot -->
      <div class="pill-wrapper">
        <span class="minimal-pill">Next-Generation Engineering & Software</span>
      </div>

      <!-- Eyebrow Brand -->
      <span class="eyebrow">{SITE.name}</span>

      <!-- Dual-Style Headline -->
      <h1 class="headline">
        <span class="headline-row">Building the technology of </span>
        <span class="headline-row">tomorrow / <span class="cursive">today.</span></span>
      </h1>

      <!-- Subtitle Description -->
      <p class="subtitle">
        From deep developer tooling and autonomous agent capabilities to
        <br class="sub-br" />
        frictionless apps crafted for everyday people.
      </p>

      <!-- Single Action Button redirecting to GitHub -->
      <div class="action-wrapper">
        <a
          href="https://github.com/alttiplano"
          target="_blank"
          rel="noopener noreferrer"
          class="github-button"
          aria-label="Visit Alttiplano on GitHub"
        >
          <svg
            class="github-icon"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"></path>
          </svg>
          <span class="button-text">github.com/alttiplano</span>
          <span class="arrow-glyph" aria-hidden="true">↗</span>
        </a>
      </div>
    </main>
  </div>
</Layout>

<style>
  :global(body) {
    overflow: hidden;
    background-color: #02050b;
  }

  .minimal-scene {
    position: relative;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    overflow: hidden;
    user-select: none;
    perspective: 1200px;
  }

  /* Centered Content Container with Micro 3D Tilt */
  .minimal-content {
    position: relative;
    z-index: 10;
    max-width: 980px;
    width: 100%;
    padding: 0 var(--spacing-24, 24px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transform-style: preserve-3d;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.4, 1);
  }

  /* Logo Styling */
  .logo-wrapper {
    position: relative;
    margin-bottom: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-backdrop {
    position: absolute;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(66, 97, 136, 0.28) 0%, rgba(0, 0, 0, 0) 70%);
    pointer-events: none;
    filter: blur(8px);
  }

  .brand-logo {
    position: relative;
    width: 58px;
    height: 58px;
    object-fit: contain;
    filter: drop-shadow(0 0 16px rgba(66, 97, 136, 0.35));
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .logo-wrapper:hover .brand-logo {
    transform: scale(1.06) rotate(-1deg);
    filter: drop-shadow(0 0 24px rgba(74, 106, 148, 0.6));
  }

  /* Pill Badge */
  .pill-wrapper {
    margin-bottom: 24px;
  }

  .minimal-pill {
    display: inline-flex;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9999px;
    padding: 6px 18px;
    font-family: var(--font-control);
    font-size: 13px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: 0.01em;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.4);
  }

  /* Eyebrow Brand */
  .eyebrow {
    font-family: var(--font-control);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #4a6a94; /* Twilight Blue tone */
    margin-bottom: 16px;
    display: block;
    text-shadow: 0 0 20px rgba(74, 106, 148, 0.4);
  }

  /* Headline */
  .headline {
    margin: 0 0 24px 0;
    font-family: var(--font-control);
    font-size: clamp(36px, 5.8vw, 68px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-shadow: 0 0 40px rgba(2, 5, 11, 0.8), 0 2px 8px rgba(0, 0, 0, 0.9);
  }

  .headline-row {
    display: block;
  }

  .cursive {
    font-family: var(--font-control-cursive, 'Caveat', cursive);
    font-style: italic;
    font-weight: 500;
    font-size: 1.14em;
    color: #557ba8; /* Vintage atmospheric cyan-blue */
    margin-left: 2px;
  }

  /* Subtitle */
  .subtitle {
    margin: 0 0 36px 0;
    font-family: var(--font-control);
    font-size: clamp(15px, 1.7vw, 19px);
    font-weight: 400;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.74);
    max-width: 660px;
    text-shadow: 0 0 24px rgba(2, 5, 11, 0.8);
  }

  @media (max-width: 640px) {
    .sub-br {
      display: none;
    }
  }

  /* Single Action Button (Air Ghost Button) */
  .action-wrapper {
    display: flex;
    justify-content: center;
  }

  .github-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #ffffff;
    border-radius: 8px; /* Strict 8px per Air design */
    padding: 10px 22px;
    font-family: var(--font-control);
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .github-button:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateY(-1px);
    box-shadow: 0 0 24px rgba(74, 106, 148, 0.25);
  }

  .github-button:active {
    transform: translateY(0);
  }

  .github-icon {
    flex-shrink: 0;
    opacity: 0.9;
  }

  .button-text {
    letter-spacing: -0.01em;
  }

  .arrow-glyph {
    font-size: 14px;
    opacity: 0.7;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .github-button:hover .arrow-glyph {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  .github-button:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 4px;
  }
</style>

<script>
  function setupParallaxTilt() {
    const card = document.getElementById('hero-card');
    if (!card) return;

    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (calm) return;

    let targetRotX = 0;
    let targetRotY = 0;
    let currentRotX = 0;
    let currentRotY = 0;
    let animId: number;

    function onPointerMove(e: PointerEvent) {
      const normX = e.clientX / window.innerWidth - 0.5;
      const normY = e.clientY / window.innerHeight - 0.5;

      // Subtle tilt limits (max ±3.5 degrees)
      targetRotY = normX * 7;
      targetRotX = -normY * 5;
    }

    function onPointerLeave() {
      targetRotX = 0;
      targetRotY = 0;
    }

    window.addEventListener('pointermove', onPointerMove, { passive: true });
    window.addEventListener('pointerleave', onPointerLeave, { passive: true });

    function tick() {
      if (!card) return;
      currentRotX += (targetRotX - currentRotX) * 0.05;
      currentRotY += (targetRotY - currentRotY) * 0.05;

      card.style.transform = `perspective(1200px) rotateX(${currentRotX.toFixed(2)}deg) rotateY(${currentRotY.toFixed(2)}deg)`;
      animId = requestAnimationFrame(tick);
    }

    animId = requestAnimationFrame(tick);

    document.addEventListener(
      'astro:before-swap',
      () => {
        cancelAnimationFrame(animId);
        window.removeEventListener('pointermove', onPointerMove);
        window.removeEventListener('pointerleave', onPointerLeave);
      },
      { once: true }
    );
  }

  setupParallaxTilt();
  document.addEventListener('astro:page-load', setupParallaxTilt);
</script>
